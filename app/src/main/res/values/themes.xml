<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Shelf" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- windowLightNavigationBar requires API 27; safely ignored on API 26. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowBackground">@color/paper_warm</item>
    </style>

    <color name="paper_warm">#FFFBF7F0</color>
    <color name="walnut">#FF8B6F47</color>
    <color name="accent">#FF4A5568</color>
</resources>
